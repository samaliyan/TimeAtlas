<?xml version="1.0" encoding="utf-8"?>
<!-- Four identical slots; WidgetRenderer fills the ones it needs and hides the rest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp"
    tools:ignore="NestedWeights">

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/row1_name"
            style="@style/WidgetName"
            android:layout_width="match_parent"
            android:gravity="center"
            android:textSize="13sp" />

        <TextClock
            android:id="@+id/row1_time"
            style="@style/WidgetTimeGrid" />

        <TextClock
            android:id="@+id/row1_day"
            style="@style/WidgetDay"
            android:layout_width="match_parent"
            android:layout_marginTop="0dp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/row2_name"
            style="@style/WidgetName"
            android:layout_width="match_parent"
            android:gravity="center"
            android:textSize="13sp" />

        <TextClock
            android:id="@+id/row2_time"
            style="@style/WidgetTimeGrid" />

        <TextClock
            android:id="@+id/row2_day"
            style="@style/WidgetDay"
            android:layout_width="match_parent"
            android:layout_marginTop="0dp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/row3_name"
            style="@style/WidgetName"
            android:layout_width="match_parent"
            android:gravity="center"
            android:textSize="13sp" />

        <TextClock
            android:id="@+id/row3_time"
            style="@style/WidgetTimeGrid" />

        <TextClock
            android:id="@+id/row3_day"
            style="@style/WidgetDay"
            android:layout_width="match_parent"
            android:layout_marginTop="0dp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/row4_name"
            style="@style/WidgetName"
            android:layout_width="match_parent"
            android:gravity="center"
            android:textSize="13sp" />

        <TextClock
            android:id="@+id/row4_time"
            style="@style/WidgetTimeGrid" />

        <TextClock
            android:id="@+id/row4_day"
            style="@style/WidgetDay"
            android:layout_width="match_parent"
            android:layout_marginTop="0dp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
